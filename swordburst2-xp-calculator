      targetHint: 'Бос қалдырсаң = келесі деңгей',
      targetPlaceholder: 'Мысалы, 50',
      quickTargets: 'Жылдам мақсаттар:',
      quick1: '+1 деңгей',
      quick5: '+5 деңгей',
      quick10: '+10 деңгей',
      quickAria: 'Жылдам мақсаттар',
      floor: 'Қабат',
      mobSource: 'Моб / XP көзі',
      mobsGroup: 'Мобтар',
      bossesGroup: 'Босстар',
      custom: 'Өз мәні',
      hp: 'HP',
      respawn: 'Респавн',
      wikiLabel: 'Викиде:',
      xpPerMob: 'Бір моб үшін XP',
      xpPerMobHint: 'Бос фармдасаң немесе буст қолдансаң, кез келген санды енгіз.',
      boostLabel: 'XP бусті',
      calc: 'Есептеу',
      errorTitle: 'Деректерді тексер:',
      errTarget: 'Мақсатты деңгей ағымдағыдан жоғары болуы керек',
      errXP: 'Моб үшін XP енгіз',
      resultsTitle: 'Есептеу нәтижелері',
      autoRecalc: 'авто-есептеу',
      xpToGoal: 'Мақсатқа дейінгі XP',
      mobsToKill: 'Өлтіру керек моб',
      levelsGained: 'Қанша деңгей аласың',
      progress: 'Мақсатқа прогресс',
      unitPcs: 'дана',
      nextLevel: 'келесі деңгейге дейін',
      alreadyEnough: 'Мақсатқа XP жеткілікті',
      haveOf: '{total} XP ішінен {done} бар',
      noKills: 'Ешкімді өлтіру қажет емес',
      perMob: 'Бір мобқа {xp} XP',
      levelRow: '{n} {word} · деңгей {current} → {target}',
      levelArrow: 'Деңгей {current} → {target}',
      levelShort: 'Деңг. {n}',
      levelOne: 'деңгей',
      levelFew: 'деңгей',
      levelMany: 'деңгей',
      corruptedSpawn: 'Atheon орнына 33% шанс',
      secUnit: 'с',
      minUnit: 'мин',
      themeLabel: 'Тақырып',
      themeDark: 'Қараңғы',
      themeLight: 'Ашық',
      perMobBoosted: 'Бір мобқа {xp} XP (x{mult})',
      footer: 'SB2 формуласы: келесі деңгейге XP = 3 × n × (n + 1) + 1 · Максималды деңгей — 450',
      playGame: 'Swordburst 2 ойнау',
      joinDiscord: 'Discord-қа қосылу',
      subscribeDevs: 'Әзірлеушілерге жазылыңыз:'
    }
  };

  var currentLang = DEFAULT_LANG;

  function t(key, vars) {
    var dict = I18N[currentLang] || I18N[DEFAULT_LANG];
    var text = dict[key];
    if (text == null) text = I18N[DEFAULT_LANG][key];
    if (text == null) text = key;
    if (vars) {
      Object.keys(vars).forEach(function (name) {
        text = text.split('{' + name + '}').join(String(vars[name]));
      });
    }
    return text;
  }

  var currentLevelEl = document.getElementById('currentLevel');
  var currentXPEl = document.getElementById('currentXP');
  var targetLevelEl = document.getElementById('targetLevel');
  var xpPerMobEl = document.getElementById('xpPerMob');
  var boostMultiplierEl = document.getElementById('boostMultiplier');
  var floorEl = document.getElementById('floor');
  var mobEl = document.getElementById('mob');
  var mobMetaEl = document.getElementById('mobMeta');
  var mobHPEl = document.getElementById('mobHP');
  var mobRespawnEl = document.getElementById('mobRespawn');
  var mobWikiRowEl = document.getElementById('mobWikiRow');
  var mobWikiEl = document.getElementById('mobWiki');
  var langSelectEl = document.getElementById('langSelect');
  var themeToggleEl = document.getElementById('themeToggle');
  var themeIconEl = document.getElementById('themeIcon');

  var currentTheme = 'dark';

  var LS_FLOOR = 'sb2calc.lastFloor';
  var LS_MOB = 'sb2calc.lastMob';
  var LS_CUSTOM_XP = 'sb2calc.lastCustomXP';
  var LS_BOOST = 'sb2calc.boost';
  var LS_THEME = 'sb2calc.theme';

  function lsGet(key) {
    try { return localStorage.getItem(key); } catch (e) { return null; }
  }

  function lsSet(key, value) {
    try { localStorage.setItem(key, value); } catch (e) {}
  }

  function lsRemove(key) {
    try { localStorage.removeItem(key); } catch (e) {}
  }

  var activeMobs = [];

  var errorBox = document.getElementById('errorBox');
  var errorList = document.getElementById('errorList');
  var resultGrid = document.getElementById('resultGrid');
  var resultsHead = document.getElementById('resultsTitle');

  var xpNeededEl = document.getElementById('xpNeeded');
  var xpSubEl = document.getElementById('xpSub');
  var mobsCountEl = document.getElementById('mobsCount');
  var mobsSubEl = document.getElementById('mobsSub');
  var levelsGainedEl = document.getElementById('levelsGained');
  var levelsSubEl = document.getElementById('levelsSub');
  var progressPctEl = document.getElementById('progressPct');
  var progressBarEl = document.getElementById('progressBar');
  var barFillEl = document.getElementById('barFill');
  var progressFromEl = document.getElementById('progressFrom');
  var progressXPEl = document.getElementById('progressXP');
  var progressToEl = document.getElementById('progressTo');

  function xpToNext(n) {
    return 3 * n * (n + 1) + 1;
  }

  function totalXP(level) {
    if (level <= 1) return 0;
    var n = level - 1;
    return n * (n + 1) * (n + 2) + n;
  }

  function fmt(value) {
    var n = Math.round(Number(value) || 0);
    var sign = n < 0 ? '-' : '';
    var digits = Math.abs(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
    return sign + digits;
  }

  function formatPercent(value) {
    if (value >= 100) return '100%';
    var rounded = value >= 10 ? Math.round(value) : Math.round(value * 10) / 10;
    return rounded + '%';
  }

  function plural(n, one, few, many) {
    var mod10 = n % 10;
    var mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return one;
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return few;
    return many;
  }

  function levelWord(n) {
    return plural(n, t('levelOne'), t('levelFew'), t('levelMany'));
  }

  function formatRespawn(value) {
    if (value === 'corrupted') return t('corruptedSpawn');
    if (typeof value === 'string') return value;
    var mins = Math.floor(value / 60);
    var secs = value % 60;
    var minPart = mins ? mins + ' ' + t('minUnit') : '';
    var secPart = secs ? secs + ' ' + t('secUnit') : (mins ? '' : '0 ' + t('secUnit'));
    return (minPart + (minPart && secPart ? ' ' : '') + secPart).trim();
  }

  function clampLevel(value, fallback) {
    var n = parseFloat(value);
    if (!isFinite(n)) return fallback;
    return Math.min(MAX_LEVEL, Math.max(1, Math.round(n)));
  }

  function showErrors(messages) {
    errorList.textContent = '';
    messages.forEach(function (message) {
      var li = document.createElement('li');
      li.textContent = message;
      errorList.appendChild(li);
    });
    errorBox.hidden = false;
  }

  function hideErrors() {
    errorBox.hidden = true;
    errorList.textContent = '';
  }

  function resetResults() {
    xpNeededEl.textContent = '—';
    xpSubEl.textContent = '—';
    mobsCountEl.textContent = '—';
    mobsSubEl.textContent = '—';
    levelsGainedEl.textContent = '—';
    levelsGainedEl.classList.remove('is-text');
    levelsSubEl.textContent = '—';
    progressPctEl.textContent = '—';
    progressFromEl.textContent = t('levelShort', { n: '—' });
    progressXPEl.textContent = '— / — XP';
    progressToEl.textContent = t('levelShort', { n: '—' });
    barFillEl.style.width = '0%';
    progressBarEl.setAttribute('aria-valuenow', '0');
    resultGrid.classList.add('is-invalid');
  }

  function calculate() {
    var errors = [];

    var currentLevel = clampLevel(currentLevelEl.value, 1);

    var currentXPRaw = parseFloat(currentXPEl.value);
    var currentXP = isFinite(currentXPRaw) ? Math.max(0, Math.round(currentXPRaw)) : 0;

    var targetRaw = targetLevelEl.value.trim();
    var targetIsImplicit = targetRaw === '';
    var targetLevel = targetIsImplicit ? currentLevel + 1 : parseFloat(targetRaw);
    if (!isFinite(targetLevel)) {
      targetLevel = currentLevel + 1;
      targetIsImplicit = true;
    }
    targetLevel = Math.min(MAX_LEVEL, Math.max(1, Math.round(targetLevel)));

    var xpPerMob = parseFloat(xpPerMobEl.value);
    var boostMultiplier = parseFloat(boostMultiplierEl.value) || 1;

    if (targetLevel <= currentLevel) {
      errors.push(t('errTarget'));
    }
    if (!isFinite(xpPerMob) || xpPerMob <= 0) {
      errors.push(t('errXP'));
    }

    if (errors.length) {
      showErrors(errors);
      resetResults();
      return;
    }

    hideErrors();
    resultGrid.classList.remove('is-invalid');

    var effectiveXPPerMob = xpPerMob * boostMultiplier;
    var pathXP = totalXP(targetLevel) - totalXP(currentLevel);
    var xpNeeded = Math.max(0, pathXP - currentXP);
    var mobs = Math.ceil(xpNeeded / effectiveXPPerMob);
    var percent = pathXP > 0 ? Math.min(100, Math.max(0, (currentXP / pathXP) * 100)) : 0;
    var doneXP = Math.min(currentXP, pathXP);

    xpNeededEl.textContent = fmt(xpNeeded);
    xpSubEl.textContent = xpNeeded === 0
      ? t('alreadyEnough')
      : t('haveOf', { done: fmt(doneXP), total: fmt(pathXP) });

    mobsCountEl.textContent = fmt(mobs);
    mobsSubEl.textContent = mobs === 0
      ? t('noKills')
      : boostMultiplier > 1
        ? t('perMobBoosted', { xp: fmt(xpPerMob), mult: boostMultiplier })
        : t('perMob', { xp: fmt(xpPerMob) });

    if (targetIsImplicit) {
      levelsGainedEl.textContent = t('nextLevel');
      levelsGainedEl.classList.add('is-text');
      levelsSubEl.textContent = t('levelArrow', { current: currentLevel, target: targetLevel });
    } else {
      var gained = targetLevel - currentLevel;
      levelsGainedEl.classList.remove('is-text');
      levelsGainedEl.textContent = '+' + gained;
      levelsSubEl.textContent = t('levelRow', {
        n: gained,
        word: levelWord(gained),
        current: currentLevel,
        target: targetLevel
      });
    }

    progressPctEl.textContent = formatPercent(percent);
    barFillEl.style.width = percent + '%';
    progressBarEl.setAttribute('aria-valuenow', String(Math.round(percent)));
    progressFromEl.textContent = t('levelShort', { n: currentLevel });
    progressXPEl.textContent = fmt(doneXP) + ' / ' + fmt(pathXP) + ' XP';
    progressToEl.textContent = t('levelShort', { n: targetLevel });
  }

  function getFloor() {
    for (var i = 0; i < FLOORS.length; i++) {
      if (FLOORS[i].id === floorEl.value) return FLOORS[i];
    }
    return FLOORS[0];
  }

  function updateMobInfo(mob) {
    if (!mob) {
      mobMetaEl.hidden = true;
      mobHPEl.textContent = '—';
      mobRespawnEl.textContent = '—';
      mobWikiRowEl.hidden = true;
      mobWikiEl.textContent = '—';
      mobWikiEl.removeAttribute('href');
      return;
    }

    mobHPEl.textContent = fmt(mob.hp);
    mobRespawnEl.textContent = formatRespawn(mob.respawn);
    mobMetaEl.hidden = false;

    mobWikiEl.textContent = mob.name;
    mobWikiEl.href = 'https://swordburst2.fandom.com/wiki/' + encodeURIComponent(mob.name.replace(/ /g, '_'));
    mobWikiRowEl.hidden = false;
  }

  function addMobGroup(label, list) {
    if (!list.length) return;
    var group = document.createElement('optgroup');
    group.label = label;
    list.forEach(function (mob) {
      var index = activeMobs.length;
      activeMobs.push(mob);
      var option = document.createElement('option');
      option.value = String(index);
      option.textContent = mob.name + ' — ' + fmt(mob.xp) + ' XP';
      group.appendChild(option);
    });
    mobEl.appendChild(group);
  }

  function buildMobs(preserve) {
    var floor = getFloor();
    var prevName = null;
    var prevCustom = false;
    var prevXP = xpPerMobEl.value;

    if (preserve) {
      if (mobEl.value === 'custom') {
        prevCustom = true;
      } else {
        var prevMob = activeMobs[Number(mobEl.value)];
        prevName = prevMob ? prevMob.name : null;
      }
    }

    activeMobs = [];
    mobEl.textContent = '';

    addMobGroup(t('mobsGroup'), floor.mobs);
    addMobGroup(t('bossesGroup'), floor.bosses);

    var custom = document.createElement('option');
    custom.value = 'custom';
    custom.textContent = t('custom');
    mobEl.appendChild(custom);

    if (prevCustom) {
      mobEl.value = 'custom';
      var savedCustomXP = prevXP !== '' ? prevXP : lsGet(LS_CUSTOM_XP);
      if (savedCustomXP) xpPerMobEl.value = savedCustomXP;
      updateMobInfo(null);
      return;
    }

    if (prevName) {
      for (var i = 0; i < activeMobs.length; i++) {
        if (activeMobs[i].name === prevName) {
          mobEl.value = String(i);
          xpPerMobEl.value = String(activeMobs[i].xp);
          updateMobInfo(activeMobs[i]);
          return;
        }
      }
    }

    if (activeMobs.length) {
      mobEl.value = '0';
      xpPerMobEl.value = String(activeMobs[0].xp);
      updateMobInfo(activeMobs[0]);
    } else {
      mobEl.value = 'custom';
      var fallbackXP = prevXP !== '' ? prevXP : lsGet(LS_CUSTOM_XP);
      if (fallbackXP) xpPerMobEl.value = fallbackXP;
      updateMobInfo(null);
    }
  }

  function buildFloors() {
    var selected = floorEl.value;
    floorEl.textContent = '';
    FLOORS.forEach(function (floor) {
      var option = document.createElement('option');
      option.value = floor.id;
      option.textContent = (floor.floor ? floor.floor + ' · ' : '') +
        floor.name + ' (' + floor.level + ')';
      floorEl.appendChild(option);
    });
    var exists = FLOORS.some(function (floor) { return floor.id === selected; });
    floorEl.value = exists ? selected : FLOORS[0].id;
  }

  function applyTheme(theme) {
    currentTheme = theme === 'light' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', currentTheme);

    themeIconEl.textContent = currentTheme === 'light' ? '☀️' : '🌙';

    var label = t('themeLabel') + ': ' + t(currentTheme === 'light' ? 'themeLight' : 'themeDark');
    themeToggleEl.setAttribute('aria-label', label);
    themeToggleEl.title = label;

    var metaTheme = document.querySelector('meta[name="theme-color"]');
    if (metaTheme) {
      metaTheme.setAttribute('content', currentTheme === 'light' ? '#f4f5fa' : '#1a1a2e');
    }

    var metaScheme = document.querySelector('meta[name="color-scheme"]');
    if (metaScheme) {
      metaScheme.setAttribute('content', currentTheme === 'light' ? 'light' : 'dark');
    }

    lsSet(LS_THEME, currentTheme);
  }

  function applyLanguage(lang) {
    if (!I18N[lang]) lang = DEFAULT_LANG;
    currentLang = lang;

    document.documentElement.lang = lang;
    document.title = t('metaTitle');

    document.querySelectorAll('[data-i18n]').forEach(function (el) {
      el.textContent = t(el.getAttribute('data-i18n'));
    });
    document.querySelectorAll('[data-i18n-placeholder]').forEach(function (el) {
      el.setAttribute('placeholder', t(el.getAttribute('data-i18n-placeholder')));
    });
    document.querySelectorAll('[data-i18n-aria-label]').forEach(function (el) {
      el.setAttribute('aria-label', t(el.getAttribute('data-i18n-aria-label')));
    });

    langSelectEl.value = lang;
    buildFloors();
    buildMobs(true);
    calculate();
    applyTheme(currentTheme);

    lsSet(LANG_KEY, lang);
  }

  function syncMobSelect() {
    if (mobEl.value === 'custom') {
      updateMobInfo(null);
      return;
    }
    var mob = activeMobs[Number(mobEl.value)];
    var value = parseFloat(xpPerMobEl.value);
    if (!mob || !isFinite(value) || value !== mob.xp) {
      mobEl.value = 'custom';
      updateMobInfo(null);
    }
  }

  function onFieldInput() {
    if (this === xpPerMobEl) {
      syncMobSelect();
      if (mobEl.value === 'custom') lsSet(LS_CUSTOM_XP, xpPerMobEl.value);
    }
    calculate();
  }

  [currentLevelEl, currentXPEl, targetLevelEl, xpPerMobEl].forEach(function (el) {
    el.addEventListener('input', onFieldInput);
  });

  langSelectEl.addEventListener('change', function () {
    applyLanguage(langSelectEl.value);
  });

  themeToggleEl.addEventListener('click', function () {
    applyTheme(currentTheme === 'dark' ? 'light' : 'dark');
  });

  boostMultiplierEl.addEventListener('change', function () {
    lsSet(LS_BOOST, boostMultiplierEl.value);
    calculate();
  });

  floorEl.addEventListener('change', function () {
    buildMobs(false);
    lsSet(LS_FLOOR, floorEl.value);
    lsRemove(LS_MOB);
    calculate();
  });

  mobEl.addEventListener('change', function () {
    lsSet(LS_MOB, mobEl.value);
    if (mobEl.value === 'custom') {
      lsSet(LS_CUSTOM_XP, xpPerMobEl.value);
      updateMobInfo(null);
      xpPerMobEl.focus({ preventScroll: true });
      xpPerMobEl.select();
      calculate();
      return;
    }
    var mob = activeMobs[Number(mobEl.value)];
    if (mob) {
      xpPerMobEl.value = String(mob.xp);
      updateMobInfo(mob);
    }
    calculate();
  });

  document.querySelectorAll('.chip[data-step]').forEach(function (button) {
    button.addEventListener('click', function () {
      var current = clampLevel(currentLevelEl.value, 1);
      var next = Math.min(MAX_LEVEL, current + Number(button.dataset.step));
      targetLevelEl.value = String(next);
      calculate();
    });
  });

  document.getElementById('calcBtn').addEventListener('click', function () {
    calculate();
    if (window.matchMedia('(max-width: 900px)').matches) {
      resultsHead.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  currentLevelEl.addEventListener('blur', function () {
    currentLevelEl.value = String(clampLevel(currentLevelEl.value, 1));
    calculate();
  });

  targetLevelEl.addEventListener('blur', function () {
    if (targetLevelEl.value.trim() === '') {
      calculate();
      return;
    }
    var value = clampLevel(targetLevelEl.value, 1);
    targetLevelEl.value = String(value);
    calculate();
  });

  var savedLang = lsGet(LANG_KEY);

  buildFloors();
  buildMobs(false);

  var savedFloor = lsGet(LS_FLOOR);
  if (savedFloor && FLOORS.some(function (floor) { return floor.id === savedFloor; })) {
    floorEl.value = savedFloor;
    buildMobs(true);
  }

  var savedMob = lsGet(LS_MOB);
  if (savedMob === 'custom') {
    mobEl.value = 'custom';
    var savedCustomXP = lsGet(LS_CUSTOM_XP);
    if (savedCustomXP) xpPerMobEl.value = savedCustomXP;
    updateMobInfo(null);
  } else if (savedMob !== null) {
    var savedIndex = Number(savedMob);
    if (isFinite(savedIndex) && savedIndex >= 0 && savedIndex < activeMobs.length) {
      mobEl.value = String(savedIndex);
      xpPerMobEl.value = String(activeMobs[savedIndex].xp);
      updateMobInfo(activeMobs[savedIndex]);
    }
  }

  var savedBoost = lsGet(LS_BOOST);
  if (savedBoost === '1' || savedBoost === '2' || savedBoost === '3') {
    boostMultiplierEl.value = savedBoost;
  }

  var savedTheme = lsGet(LS_THEME);
  if (savedTheme !== 'dark' && savedTheme !== 'light') {
    savedTheme = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
      ? 'light'
      : 'dark';
  }
  applyTheme(savedTheme);

  applyLanguage(savedLang && I18N[savedLang] ? savedLang : DEFAULT_LANG);
})();
</script>
</body>
</html>
